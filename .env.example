# Supabase project URL and publishable key (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key is accepted as a fallback by the current client setup.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server-only secret. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
